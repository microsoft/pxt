{
    "compilerOptions": {
        "target": "es2017",
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "declaration": true,
        "outFile": "../built/pxtsimdom.js",
        "newLine": "LF",
        "sourceMap": false,
        "moduleResolution": "node",
        "lib": [
            "dom",
            "dom.iterable",
            "scripthost",
            "es2017",
            "ES2018.Promise"
        ],
        "incremental": true,
        "skipLibCheck": true
    },
    "files": [
        "../built/pxtsimcore.d.ts"
    ],
    "include": [
        "**/*.ts"
    ]
}