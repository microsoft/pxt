<xml xmlns="https://developers.google.com/blockly/xml">
    <variables>
        <variable id="sprite">mySprite</variable>
        <variable id="element">value</variable>
    </variables>
    <block type="function_definition">
        <mutation name="useSprites" functionid="use-sprites">
            <arg name="list" id="list-parameter" type="Array"/>
        </mutation>
        <field name="function_name">useSprites</field>
        <value name="list-parameter">
            <shadow type="argument_reporter_array"><field name="VALUE">list</field></shadow>
        </value>
        <statement name="STACK">
            <block type="console_log">
                <value name="text">
                    <block type="lists_index_get">
                        <value name="LIST"><block type="argument_reporter_array"><field name="VALUE">list</field></block></value>
                        <value name="INDEX"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
                    </block>
                </value>
                <next>
                    <block type="pxt_controls_for_of">
                        <value name="VAR"><shadow type="variables_get_reporter"><field name="VAR" id="element">value</field></shadow></value>
                        <value name="LIST"><block type="argument_reporter_array"><field name="VALUE">list</field></block></value>
                        <next>
                            <block type="variables_set">
                                <field name="VAR" id="sprite">mySprite</field>
                                <value name="VALUE">
                                    <block type="lists_index_get">
                                        <value name="LIST"><block type="argument_reporter_array"><field name="VALUE">list</field></block></value>
                                        <value name="INDEX"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
                                    </block>
                                </value>
                            </block>
                        </next>
                    </block>
                </next>
            </block>
        </statement>
    </block>
    <block type="pxt-on-start">
        <statement name="HANDLER">
            <block type="variables_set">
                <field name="VAR" id="sprite">mySprite</field>
                <value name="VALUE">
                    <block type="lists_index_get">
                        <value name="LIST"><block type="test_all_sprites"/></value>
                        <value name="INDEX"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
                    </block>
                </value>
            </block>
        </statement>
    </block>
</xml>
