<xml xmlns="http://www.w3.org/1999/xhtml">
<block type="pxt-on-start">
<statement name="HANDLER">
<block type="variables_set">
<field name="VAR">selectedColor</field>
<value name="VALUE">
<shadow type="math_number"><field name="NUM">0</field></shadow>
<block type="makecode_color_picker">
<mutation color="#6554C0" />
<field name="FORMAT">hex</field>
<value name="HEX_INPUT">
<shadow type="makecode_color_picker_string">
<field name="TEXT">&#35;123456</field>
</shadow>
</value>
</block>
</value>
<next>
<block type="test_color_argument">
<value name="color">
<shadow type="test_color_picker"/>
<block type="variables_get">
<field name="VAR">selectedColor</field>
</block>
</value>
<next>
<block type="test_color_argument">
<value name="color">
<shadow type="makecode_color_picker">
<mutation color="#6554C0" duplicateondrag="true" />
<field name="FORMAT">hex</field>
<value name="HEX_INPUT">
<shadow type="makecode_color_picker_string">
<field name="TEXT">&#35;abcdef</field>
</shadow>
</value>
</shadow>
</value>
</block>
</next>
</block>
</next>
</block>
</statement>
</block>
</xml>
